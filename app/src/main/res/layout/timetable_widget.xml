<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header Bar: Day/Mode Info & Toggle Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="Timetable"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <!-- Live Period Badge -->
        <TextView
            android:id="@+id/widget_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_badge_bg"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="LIVE"
            android:textColor="#38BDF8"
            android:textSize="9sp"
            android:visibility="gone" />

        <!-- View Mode Toggle Button (Timetable <-> Tasks) -->
        <TextView
            android:id="@+id/widget_mode_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="▼ Tasks"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Divider Line -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1AFFFFFF" />

    <!-- 1. TIMETABLE VIEW CONTAINER -->
    <LinearLayout
        android:id="@+id/widget_timetable_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <!-- Previous Period Arrow Button -->
        <TextView
            android:id="@+id/widget_period_prev_btn"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Period Details Column -->
        <LinearLayout
            android:id="@+id/widget_period_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_current_period_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Period 1 • 8:55 AM - 9:50 AM"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_current_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:text="U25CSG18"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_current_faculty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="DBMS Lab • Ms. Sri Sakthi A"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Next Period Arrow Button -->
        <TextView
            android:id="@+id/widget_period_next_btn"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 2. TASKS / PENDING ASSIGNMENTS VIEW CONTAINER -->
    <LinearLayout
        android:id="@+id/widget_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Previous Task Arrow Button -->
        <TextView
            android:id="@+id/widget_task_prev_btn"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Task Info Column -->
        <LinearLayout
            android:id="@+id/widget_task_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_task_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Task 1 of 3 • High Priority"
                android:textColor="#F59E0B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:text="DBMS Lab Exercise 4"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_task_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="Due: Tomorrow, 5:00 PM"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Interactive Complete Dot Button (Tap to mark complete) -->
        <TextView
            android:id="@+id/widget_task_complete_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_dot_bg"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="✓"
            android:textColor="#10B981"
            android:textSize="12sp" />

        <!-- Next Task Arrow Button -->
        <TextView
            android:id="@+id/widget_task_next_btn"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Bottom Status / Next Class Indicator -->
    <TextView
        android:id="@+id/widget_next_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:singleLine="true"
        android:text="Tap to open timetable"
        android:textColor="#64748B"
        android:textSize="9sp" />

</LinearLayout>
